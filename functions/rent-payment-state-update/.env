# =============================================================================
# RENT PAYMENT STATE UPDATE — Function Environment Variables
# =============================================================================
#
# These variables are synced to the Appwrite Cloud Function via:
#   appwrite push functions --function-id rent-payment-state-update --with-variables
#
# The following are INJECTED AUTOMATICALLY by the Appwrite runtime:
#   APPWRITE_FUNCTION_PROJECT_ID
#   APPWRITE_FUNCTION_API_KEY
#   APPWRITE_FUNCTION_ID
#   APPWRITE_FUNCTION_NAME
#   APPWRITE_FUNCTION_DEPLOYMENT
#   APPWRITE_FUNCTION_RUNTIME_NAME
#
# You do NOT need to set those here.
# =============================================================================

# Appwrite endpoint (use your regional cloud endpoint)
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Database ID where the rent_ledger collection lives
APPWRITE_DATABASE_ID=69e5580f00087e980ef3

# Rent Ledger collection ID (the time-based ledger for monthly rent cycles)
RENT_LEDGER_COLLECTION_ID=rent_ledger
